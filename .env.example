# Single-project configuration (or use appsettings.json for multiple projects)
POLARION_URL=https://polarion.example.com
POLARION_USERNAME=read-only-user
POLARION_PASSWORD=change-me
POLARION_PROJECT_ID=my_project
POLARION_TRANSPORT=stdio
# Optional: path to a reference-format config and configured project alias
# POLARION_CONFIG=appsettings.json
# POLARION_PROJECT=default
# POLARION_VERIFY_TLS=true
# POLARION_TIMEOUT=60
